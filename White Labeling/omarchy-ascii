#!/usr/bin/env bash
#
# omarchy-ascii — render text as ASCII art in Omarchy's own wordmark font
# (Delta Corps Priest 1, the same FIGlet font the Omarchy logo itself uses)
# and optionally push it straight into the screensaver or about-screen.
#
# This exists because `omarchy ascii "text"` ships on newer Omarchy branches
# but hasn't landed on every channel yet. This script is fully self-contained
# (font is embedded below) so it works regardless of what's installed.
#
# Usage:
#   omarchy-ascii "TEXT"                    Print the art to stdout
#   omarchy-ascii "TEXT" --to screensaver   Write to the screensaver file
#   omarchy-ascii "TEXT" --to about         Write to the About-screen file
#   omarchy-ascii "TEXT" --to fastfetch     Alias for --to about (see note)
#   omarchy-ascii "TEXT" --to /some/path    Write to a custom file
#   omarchy-ascii "TEXT" --preview          Write to screensaver AND show it now
#
# Options:
#   --to <screensaver|about|fastfetch|PATH>   Destination for the generated art
#   --preview                        After writing, immediately trigger the
#                                     screensaver so you can see it (Hyprland)
#   -h, --help                       Show this help
#
# Note: on Omarchy, the terminal welcome banner (fastfetch) and the About
# window read the SAME file: ~/.config/omarchy/branding/about.txt. So
# --to about and --to fastfetch are the same thing, and no fastfetch
# config.jsonc editing is needed. The screensaver is a separate file.
#
# This script does NOT touch the graphical boot splash or SDDM login
# screen — for those, use Omarchy's own built-in commands with a PNG:
#   omarchy plymouth preview '<bg-hex>' '<fg-hex>' logo.png preview.png
#   omarchy plymouth set     '<bg-hex>' '<fg-hex>' logo.png
#   omarchy plymouth reset   (to revert)

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-ascii"
FONT_PATH="$CACHE_DIR/delta-corps-priest-1.flf"

SCREENSAVER_FILE="$HOME/.config/omarchy/branding/screensaver.txt"
ABOUT_FILE="$HOME/.config/omarchy/branding/about.txt"

usage() {
  sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'
}

ensure_font() {
  mkdir -p "$CACHE_DIR"
  if [[ ! -s "$FONT_PATH" ]]; then
    # Extract the embedded font (appended after the __FONT_B64__ marker below)
    awk '/^__FONT_B64__$/{found=1; next} found' "$0" | base64 -d > "$FONT_PATH"
  fi
}

ensure_figlet() {
  if command -v figlet >/dev/null 2>&1; then
    return 0
  fi

  echo "figlet is not installed. Attempting to install it..." >&2
  if command -v omarchy-pkg-install >/dev/null 2>&1; then
    omarchy-pkg-install figlet
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --noconfirm figlet
  elif command -v yay >/dev/null 2>&1; then
    yay -S --noconfirm figlet
  else
    echo "Could not find a package manager to install figlet automatically." >&2
    echo "Install it yourself, then re-run: sudo pacman -S figlet" >&2
    exit 1
  fi
}

resolve_destination() {
  local dest="$1"
  case "$dest" in
    screensaver)      echo "$SCREENSAVER_FILE" ;;
    about|fastfetch)  echo "$ABOUT_FILE" ;;
    *)                echo "$dest" ;;
  esac
}

main() {
  local text=""
  local to=""
  local preview=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --to)
        to="${2:-}"
        shift 2
        ;;
      --preview)
        preview=true
        shift
        ;;
      *)
        if [[ -z "$text" ]]; then
          text="$1"
        else
          text="$text $1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$text" ]]; then
    echo "Usage: $SCRIPT_NAME \"TEXT\" [--to screensaver|about|PATH] [--preview]" >&2
    exit 1
  fi

  ensure_figlet
  ensure_font

  local art
  art="$(figlet -f "$FONT_PATH" -- "$text")"

  if [[ -z "$to" ]]; then
    printf '%s\n' "$art"
    exit 0
  fi

  local dest_file
  dest_file="$(resolve_destination "$to")"
  mkdir -p "$(dirname "$dest_file")"
  printf '%s\n' "$art" > "$dest_file"
  echo "Wrote ASCII art to $dest_file" >&2

  if [[ "$to" == "about" || "$to" == "fastfetch" ]]; then
    echo "This file feeds both the About window and your fastfetch terminal banner." >&2
    echo "Run 'fastfetch' or open a new terminal to see it." >&2
  fi

  if [[ "$preview" == true ]]; then
    if command -v omarchy-launch-screensaver >/dev/null 2>&1; then
      omarchy-launch-screensaver
    elif command -v hyprlock >/dev/null 2>&1 && [[ "$to" == "screensaver" ]]; then
      echo "No dedicated screensaver-launch command found; open it from the Omarchy menu (Super + Space) instead." >&2
    else
      echo "Saved. Trigger the screensaver from the Omarchy menu to preview it." >&2
    fi
  fi
}

main "$@"

exit 0
__FONT_B64__
